## Legal Metrology Compliance Portal — Environment Configuration

## =============================
## Module 3 — FastAPI Backend
## =============================

# Google Gemini Vision API Key (REQUIRED for OCR & Vision AI)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret (min 32 characters, change in production)
SECRET_KEY=changeme_use_a_long_random_secret_key_in_production

# Token expiry in minutes (default: 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Path to Module 2 (Vision AI pipeline)
# Relative to legal_metrology_module3/
MODULE2_PATH=../legal_metrology_module2

# Path to Rules Knowledge Base JSON (from Module 1)
RULES_KB_PATH=../legal_metrology_compliance/output/rules_knowledge_base.json
